{
  "name": "jellyfin",
  "version": "1.0.0",
  "title": "Jellyfin",
  "description": "Free media server for your movies, shows and music. Opens on port 8096. Uses the GPU for transcoding when the machine has one.",
  "category": "Media",
  "icon": "🎬",
  "author": "sys1",
  "homepage": "https://jellyfin.org",
  "run": {
    "kind": "container",
    "image": "jellyfin/jellyfin:latest",
    "network": true,
    "ports": [
      "8096:8096"
    ],
    "volumes": [
      "/config"
    ],
    "localVolumes": [
      "/cache",
      "/media"
    ],
    "memoryMB": 2048,
    "gpu": true,
    "service": true
  }
}
